---
import { profile, affiliations } from '../data/profile';
import Sticker from './Sticker.astro';
---
<section class="hero-section">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="hero-eyebrow">Ph.D. Student · Trustworthy AI · Federated Learning</p>
      <h1>{profile.heroTitle}</h1>
      <p class="hero-body">{profile.heroBody}</p>
      <div class="hero-actions">
        <a class="button button-dark" href="/publications/">View Publications</a>
        <a class="button button-green" href="/research/">Explore Research</a>
        <a class="button button-ghost" href="/cv/">Download CV</a>
        <a class="button button-blue" href={profile.links.email}>Email Me</a>
      </div>
      <div class="affiliation-strip" aria-label="Affiliations">
        {affiliations.map((affiliation) => (
          <a href={affiliation.url} target={affiliation.url.startsWith('http') ? '_blank' : undefined} rel={affiliation.url.startsWith('http') ? 'noreferrer' : undefined}>
            <img src={affiliation.image} alt={`${affiliation.name} placeholder badge`} loading="lazy" />
          </a>
        ))}
      </div>
    </div>

    <div class="hero-visual" aria-label="Academic portrait and research stickers">
      <div class="graph-doodle" aria-hidden="true">
        <span></span><span></span><span></span><span></span>
      </div>
      <div class="portrait-card">
        <img src={profile.headshot} alt="Placeholder portrait for Thinh Nguyen" />
        <p>Portrait placeholder · replace in <code>/public/assets</code></p>
      </div>
      <Sticker label="Ph.D. Student" tone="yellow" className="hero-sticker sticker-a" />
      <Sticker label="SAIL Lab" tone="mint" className="hero-sticker sticker-b" />
      <Sticker label="CVPR 2026 × 2" tone="green" className="hero-sticker sticker-c" />
      <Sticker label="No raw data? Still learning." tone="blue" className="hero-sticker sticker-d" />
    </div>
  </div>
</section>
